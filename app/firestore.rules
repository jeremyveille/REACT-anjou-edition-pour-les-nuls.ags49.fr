rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Vérifie si l'utilisateur possède les privilèges administrateur
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'jeremy.veille@hotmail.fr',
          'admin@anjou-edition.fr',
          'pveille@ymail.com'
        ]
      );
    }

    // Formulaire de contact :
    // Création publique contrôlée avec validation de schéma stricte.
    // Lecture et suppression réservées exclusivement aux administrateurs.
    match /contacts/{document} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() >= 2 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string 
                    && request.resource.data.email.size() >= 5 
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.subject is string 
                    && request.resource.data.subject.size() >= 2 
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string 
                    && request.resource.data.message.size() >= 5 
                    && request.resource.data.message.size() <= 5000;
                    
      allow read, update, delete: if isAdmin();
    }

    // Pages du site :
    match /pages/{pageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Articles :
    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Journal d'audit éditorial (auditLogs) :
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Collections publiques du portail (Flipbooks, Médias, Galerie, Vidéos, Menus, Actualités, Paramètres) :
    // Lecture publique autorisée pour l'affichage du portail.
    // Écritures réservées aux administrateurs authentifiés.
    match /flipbooks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flipbooks/{docId}/{allSubcollections=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /medias/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menus/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Comptes et gestion des écrivains :
    // Consultation et modifications réservées aux administrateurs.
    match /accounts/{docId} {
      allow read, write: if isAdmin();
    }

    // Règle par défaut : Tout autre accès non explicitement autorisé est strictement refusé (Deny by default).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
