rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Formulaire de contact :
    // Création publique contrôlée avec validation de schéma stricte.
    // Lecture et suppression réservées aux administrateurs connectés.
    match /contacts/{document} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() >= 2 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string 
                    && request.resource.data.email.size() >= 5 
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.subject is string 
                    && request.resource.data.subject.size() >= 2 
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string 
                    && request.resource.data.message.size() >= 5 
                    && request.resource.data.message.size() <= 5000;
                    
      allow read, update, delete: if isAuthenticated();
    }

    // Pages du site :
    // Lecture publique autorisée UNIQUEMENT pour les pages au statut publié.
    // Les brouillons et pages en attente sont réservés aux utilisateurs connectés.
    // Écritures et suppressions réservées aux utilisateurs connectés.
    match /pages/{pageId} {
      allow read: if resource.data.status in ['published', 'Publié'] || isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Articles :
    // Lecture publique autorisée UNIQUEMENT pour les articles publiés.
    // Écritures et suppressions réservées aux utilisateurs connectés.
    match /articles/{articleId} {
      allow read: if resource.data.status in ['published', 'Publié'] || isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Journal d'audit éditorial (auditLogs) :
    // Piste d'audit immuable : lecture et création autorisées aux connectés, modification et suppression interdites.
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Collections publiques du portail (Flipbooks, Médias, Galerie, Vidéos, Menus, Actualités, Paramètres) :
    // Lecture publique autorisée pour l'affichage du portail.
    // Écritures réservées aux utilisateurs connectés.
    match /flipbooks/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /medias/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /videos/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /menus/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /accounts/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Règle par défaut : Tout autre accès non explicitement autorisé est strictement refusé (Deny by default).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
