rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function published() { return resource.data.status == 'published'; }
    function validStatus() {
      return request.resource.data.status in ['draft', 'pending_review', 'approved', 'published'];
    }
    match /contacts/{document} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'timestamp'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 150
        && request.resource.data.subject is string && request.resource.data.subject.size() >= 2 && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 5000
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /pages/{id} {
      allow read: if isAdmin() || published();
      allow create, update: if isAdmin() && validStatus();
      allow delete: if isAdmin();
    }
    match /articles/{id} {
      allow read: if isAdmin() || published();
      allow create, update: if isAdmin() && validStatus();
      allow delete: if isAdmin();
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
    match /{collection}/{id} {
      allow read: if collection in ['flipbooks', 'medias', 'media', 'gallery', 'videos', 'news', 'menus'];
      allow write: if collection in ['flipbooks', 'medias', 'media', 'gallery', 'videos', 'news', 'menus'] && isAdmin();
    }
    match /flipbooks/{id}/{nested=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // This document contains only the public homepage selection.
    match /settings/homepage {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['featuredArticleId', 'updatedAt'])
        && request.resource.data.featuredArticleId is string;
      allow delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && id != 'homepage';
    }
    // Identity changes are performed only by the privileged account callable.
    match /accounts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
