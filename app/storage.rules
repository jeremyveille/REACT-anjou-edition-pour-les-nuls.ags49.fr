rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public media files and flipbook PDFs:
    // Anyone can read and download published assets.
    // Uploads and deletions require authenticated admin access with max size limit (50MB).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }
  }
}
