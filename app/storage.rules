rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Vérifie si l'utilisateur possède les privilèges administrateur
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'jeremy.veille@hotmail.fr',
          'admin@anjou-edition.fr',
          'pveille@ymail.com',
          'pveille49@gmail.com'
        ]
      );
    }

    // Public media files and flipbook PDFs:
    // Anyone can read and download published assets.
    // Uploads and deletions require authenticated admin access with max size limit (50MB).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }
  }
}
